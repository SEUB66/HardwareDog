{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SEUB66/HardwareDog/protocol/hdp_v1.json",
  "title": "HDP v1 — Hardware Dog Protocol",
  "description": "One JSON object per line (NDJSON, UTF-8). Device frames carry `type` and `t` (device uptime, ms). Host commands carry `cmd`. This schema is the contract for every HDP producer: the firmware and the simulator must both emit frames that validate. Enum values are shown in their canonical case; decoders accept any case (docs/PROTOCOL.md).",
  "definitions": {
    "t": { "type": "number", "minimum": 0, "description": "Device uptime in milliseconds. Never goes backwards." },
    "check": { "enum": ["PASS", "WARN", "FAIL", "PENDING", "UNKNOWN"] },
    "optString": { "type": ["string", "null"] },
    "optNumber": { "type": ["number", "null"] },
    "hop": {
      "type": "object",
      "required": ["address", "status"],
      "properties": {
        "address": { "$ref": "#/definitions/optString" },
        "status": { "$ref": "#/definitions/check" }
      },
      "additionalProperties": false
    },
    "probeTest": { "enum": ["PING", "DNS", "TCP", "HTTP"] },

    "hello": {
      "type": "object",
      "required": ["type", "t", "proto", "device", "rev", "fw"],
      "properties": {
        "type": { "const": "hello" },
        "t": { "$ref": "#/definitions/t" },
        "proto": { "const": 1 },
        "device": { "type": "string", "minLength": 1 },
        "rev": { "type": "string", "minLength": 1 },
        "fw": { "type": "string", "minLength": 1 },
        "chip": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$",
          "description": "48-bit factory id: the eFuse MAC, 12 lowercase hex. The identity a host keys on. Optional: devices made before it send only 'device', which is 24 bits of the MAC and not unique."
        },
        "caps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["power", "usb", "uart", "i2c", "net", "probe"] },
          "description": "What this device can observe. Optional: a hello without caps (devices made before caps) means every capability. Silence about a capability the device does not have is never an observation: no 'usb' means USB is not monitored, not that no USB device is present."
        }
      },
      "additionalProperties": false
    },
    "power": {
      "type": "object",
      "required": ["type", "t", "v", "i"],
      "properties": {
        "type": { "const": "power" },
        "t": { "$ref": "#/definitions/t" },
        "v": { "type": "number", "description": "Volts on the measured rail." },
        "i": { "type": "number", "description": "Amps drawn by the target." }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["pct", "abs"],
      "properties": {
        "pct": { "type": "number", "minimum": 0, "description": "Part proportional to the reading, in percent." },
        "abs": { "type": "number", "minimum": 0, "description": "Fixed part, in the unit of the quantity (V or A)." }
      },
      "additionalProperties": false,
      "description": "Expected maximum error: |error| <= pct % of the reading + abs."
    },
    "power.meter": {
      "type": "object",
      "required": ["type", "t", "sensor", "shunt_ohm", "v_max", "i_max", "v_res", "i_res", "rate_hz", "v_err", "i_err", "basis", "cal"],
      "properties": {
        "type": { "const": "power.meter" },
        "t": { "$ref": "#/definitions/t" },
        "sensor": { "type": "string", "minLength": 1, "description": "Sensor identity, only as verified by the device (rule 6)." },
        "shunt_ohm": { "type": "number", "exclusiveMinimum": 0 },
        "v_max": { "type": "number", "exclusiveMinimum": 0, "description": "Highest rail voltage measured within specification (V)." },
        "i_max": { "type": "number", "exclusiveMinimum": 0, "description": "Full-scale current (A), either direction." },
        "v_res": { "type": "number", "exclusiveMinimum": 0, "description": "Voltage resolution, one LSB (V)." },
        "i_res": { "type": "number", "exclusiveMinimum": 0, "description": "Current resolution, one LSB (A)." },
        "rate_hz": { "type": "number", "exclusiveMinimum": 0, "description": "power frames per second." },
        "v_err": { "$ref": "#/definitions/error" },
        "i_err": { "$ref": "#/definitions/error" },
        "basis": { "enum": ["DATASHEET", "CALIBRATION"], "description": "Where v_err / i_err come from: worst case from the datasheets, or measured against a reference instrument." },
        "cal": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["date", "ref", "v_gain", "i_gain", "i_offset"],
              "properties": {
                "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "ref": { "type": "string", "minLength": 1, "description": "Reference instrument the device was compared against." },
                "v_gain": { "type": "number" },
                "i_gain": { "type": "number" },
                "i_offset": { "type": "number", "description": "A, added after the gain." }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "What the power numbers are worth. Sent when the sensor is verified, and in reply to hello. Diagnostic measurement, not certified metrology."
    },
    "usb.attach": {
      "type": "object",
      "required": ["type", "t", "speed", "vid", "pid", "cls", "power"],
      "properties": {
        "type": { "const": "usb.attach" },
        "t": { "$ref": "#/definitions/t" },
        "speed": { "enum": ["LOW", "FULL", "HIGH", "SUPER"], "description": "Speed at which the device enumerated on Hardware Dog, not its maximum capability." },
        "vid": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "pid": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "cls": { "type": "string" },
        "power": { "enum": ["BUS", "SELF"] },
        "manufacturer": { "$ref": "#/definitions/optString" },
        "product": { "$ref": "#/definitions/optString" },
        "serial": { "$ref": "#/definitions/optString" }
      },
      "additionalProperties": false
    },
    "usb.detach": {
      "type": "object",
      "required": ["type", "t"],
      "properties": { "type": { "const": "usb.detach" }, "t": { "$ref": "#/definitions/t" } },
      "additionalProperties": false
    },
    "uart.config": {
      "type": "object",
      "required": ["type", "t", "port", "baud", "bits", "parity", "stop"],
      "properties": {
        "type": { "const": "uart.config" },
        "t": { "$ref": "#/definitions/t" },
        "port": { "type": "string" },
        "baud": { "type": "integer", "minimum": 300 },
        "bits": { "enum": [7, 8] },
        "parity": { "enum": ["NONE", "EVEN", "ODD"] },
        "stop": { "enum": [1, 2] }
      },
      "additionalProperties": false
    },
    "uart.rx": {
      "type": "object",
      "required": ["type", "t", "data"],
      "properties": {
        "type": { "const": "uart.rx" },
        "t": { "$ref": "#/definitions/t" },
        "data": { "type": "string", "description": "One received line, without its terminator." }
      },
      "additionalProperties": false
    },
    "uart.error": {
      "type": "object",
      "required": ["type", "t", "kind"],
      "properties": {
        "type": { "const": "uart.error" },
        "t": { "$ref": "#/definitions/t" },
        "kind": { "type": "string", "examples": ["framing", "parity", "overrun", "break"] }
      },
      "additionalProperties": false
    },
    "i2c.scan": {
      "type": "object",
      "required": ["type", "t", "speed", "devices"],
      "properties": {
        "type": { "const": "i2c.scan" },
        "t": { "$ref": "#/definitions/t" },
        "speed": { "type": "number", "description": "Bus clock in Hz." },
        "every_ms": { "type": "integer", "minimum": 0, "description": "Optional. The periodic scan this one belongs to (i2c.watch, or set at boot); absent or 0: a one-off scan." },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["addr"],
            "properties": {
              "addr": { "type": "integer", "minimum": 0, "maximum": 127 },
              "ident": { "$ref": "#/definitions/optString", "description": "Only when verified by the firmware." },
              "method": { "$ref": "#/definitions/optString", "description": "How the identity was verified. Required with ident." }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "i2c.error": {
      "type": "object",
      "required": ["type", "t", "kind"],
      "properties": {
        "type": { "const": "i2c.error" },
        "t": { "$ref": "#/definitions/t" },
        "kind": {
          "enum": ["SDA_LOW", "SCL_LOW", "TIMEOUT", "ARB_LOST"],
          "description": "SDA_LOW / SCL_LOW: the line sits low while the bus is idle (missing pull-up, a device holding it, a short). TIMEOUT: a transfer did not complete. ARB_LOST: the master lost arbitration (noise, another master)."
        },
        "detail": { "$ref": "#/definitions/optString" },
        "every_ms": { "type": "integer", "minimum": 0, "description": "Optional. The periodic scan that hit the fault; absent: a one-off scan." }
      },
      "additionalProperties": false,
      "description": "The target I2C bus failed. A scan that hits a bus fault is not sent: an empty scan would read as devices gone."
    },
    "net.status": {
      "type": "object",
      "required": ["type", "t", "link", "address", "dhcp", "gateway", "dns", "internet", "latency", "loss"],
      "properties": {
        "type": { "const": "net.status" },
        "t": { "$ref": "#/definitions/t" },
        "link": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["up"],
              "properties": {
                "up": { "type": "boolean" },
                "mbps": { "$ref": "#/definitions/optNumber" },
                "duplex": { "enum": ["FULL", "HALF", null] }
              },
              "additionalProperties": false
            }
          ]
        },
        "address": { "$ref": "#/definitions/optString" },
        "dhcp": { "$ref": "#/definitions/check" },
        "gateway": { "$ref": "#/definitions/hop" },
        "dns": { "$ref": "#/definitions/hop" },
        "internet": { "$ref": "#/definitions/check" },
        "latency": { "$ref": "#/definitions/optNumber" },
        "loss": { "$ref": "#/definitions/optNumber" }
      },
      "additionalProperties": false
    },
    "probe.result": {
      "type": "object",
      "required": ["type", "t", "id", "test", "status", "detail"],
      "properties": {
        "type": { "const": "probe.result" },
        "t": { "$ref": "#/definitions/t" },
        "id": { "type": "string" },
        "test": { "$ref": "#/definitions/probeTest" },
        "status": { "$ref": "#/definitions/check" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "probe.done": {
      "type": "object",
      "required": ["type", "t", "id"],
      "properties": { "type": { "const": "probe.done" }, "t": { "$ref": "#/definitions/t" }, "id": { "type": "string" } },
      "additionalProperties": false
    },
    "log": {
      "type": "object",
      "required": ["type", "t", "level", "message"],
      "properties": {
        "type": { "const": "log" },
        "t": { "$ref": "#/definitions/t" },
        "level": { "enum": ["info", "warn", "error"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "required": ["type", "t", "id"],
      "properties": {
        "type": { "const": "time" },
        "t": { "$ref": "#/definitions/t" },
        "id": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "additionalProperties": false,
      "description": "Answer to the host command time, sent at once: the device clock now. The host brackets it between sending and receiving to align this device's clock with others, with a known error."
    },

    "deviceFrame": {
      "oneOf": [
        { "$ref": "#/definitions/hello" },
        { "$ref": "#/definitions/power" },
        { "$ref": "#/definitions/power.meter" },
        { "$ref": "#/definitions/usb.attach" },
        { "$ref": "#/definitions/usb.detach" },
        { "$ref": "#/definitions/uart.config" },
        { "$ref": "#/definitions/uart.rx" },
        { "$ref": "#/definitions/uart.error" },
        { "$ref": "#/definitions/i2c.scan" },
        { "$ref": "#/definitions/i2c.error" },
        { "$ref": "#/definitions/net.status" },
        { "$ref": "#/definitions/probe.result" },
        { "$ref": "#/definitions/probe.done" },
        { "$ref": "#/definitions/log" },
        { "$ref": "#/definitions/time" }
      ]
    },

    "hostCommand": {
      "oneOf": [
        {
          "type": "object",
          "required": ["cmd", "proto"],
          "properties": { "cmd": { "const": "hello" }, "proto": { "const": 1 } },
          "additionalProperties": false
        },
        { "type": "object", "required": ["cmd"], "properties": { "cmd": { "const": "usb.enumerate" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["cmd", "baud"],
          "properties": { "cmd": { "const": "uart.config" }, "baud": { "type": "integer", "minimum": 300, "maximum": 4000000 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["cmd", "data"],
          "properties": { "cmd": { "const": "uart.tx" }, "data": { "type": "string" } },
          "additionalProperties": false
        },
        { "type": "object", "required": ["cmd"], "properties": { "cmd": { "const": "i2c.scan" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["cmd", "every_ms"],
          "properties": {
            "cmd": { "const": "i2c.watch" },
            "every_ms": { "type": "integer", "minimum": 0, "maximum": 600000, "description": "Scan the target bus this often (ACTIVE). 0 stops. Below 1000 is refused by devices." }
          },
          "additionalProperties": false
        },
        { "type": "object", "required": ["cmd"], "properties": { "cmd": { "const": "net.refresh" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["cmd", "every_ms"],
          "properties": {
            "cmd": { "const": "net.watch" },
            "every_ms": { "type": "integer", "minimum": 0, "maximum": 600000, "description": "Check gateway (ping), DNS (resolve dns) and upstream (TCP 443) this often (ACTIVE), and report it in net.status. 0 stops." },
            "dns": { "type": "string", "pattern": "^[A-Za-z0-9.-]{1,253}$", "description": "Name to resolve. Absent: DNS stays UNKNOWN." },
            "upstream": { "type": "string", "pattern": "^[A-Za-z0-9.-]{1,253}$", "description": "Host beyond the gateway to reach. Absent: INTERNET stays UNKNOWN." }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["cmd", "date", "ref", "v_gain", "i_gain", "i_offset", "v_err", "i_err"],
          "properties": {
            "cmd": { "const": "meter.cal" },
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "ref": { "type": "string", "minLength": 1, "maxLength": 64 },
            "v_gain": { "type": "number", "minimum": 0.9, "maximum": 1.1 },
            "i_gain": { "type": "number", "minimum": 0.9, "maximum": 1.1 },
            "i_offset": { "type": "number", "minimum": -0.05, "maximum": 0.05 },
            "v_err": { "type": "number", "minimum": 0, "description": "Largest residual seen against the reference (V)." },
            "i_err": { "type": "number", "minimum": 0, "description": "Largest residual seen against the reference (A)." }
          },
          "additionalProperties": false,
          "description": "Store a calibration on the device. It answers with power.meter."
        },
        { "type": "object", "required": ["cmd"], "properties": { "cmd": { "const": "meter.clear" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["cmd", "id"],
          "properties": { "cmd": { "const": "time" }, "id": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
          "additionalProperties": false,
          "description": "Ask for the device clock. The device answers with a time frame carrying the same id."
        },
        {
          "type": "object",
          "required": ["cmd", "id", "target", "tests"],
          "properties": {
            "cmd": { "const": "probe" },
            "id": { "type": "string" },
            "target": { "type": "string", "pattern": "^[A-Za-z0-9.-]{1,253}$" },
            "tests": { "type": "array", "items": { "$ref": "#/definitions/probeTest" }, "minItems": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [{ "$ref": "#/definitions/deviceFrame" }, { "$ref": "#/definitions/hostCommand" }]
}
