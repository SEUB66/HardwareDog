{
  "name": "hardware-dog-web",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware Dog local diagnostic interface",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "assets": "node scripts/build-brand-assets.mjs",
    "companion": "node scripts/build-companion-scenes.mjs && node scripts/build-dog-scenes.mjs && node scripts/build-home-scenes.mjs",
    "demo": "vite --open /diagnostic.html?demo",
    "cases": "UPDATE_CASES=1 vitest run test/cases.test.ts",
    "docs:sync": "node scripts/sync-raw-docs.mjs",
    "cli": "vite build --config vite.cli.config.ts",
    "test:cases": "npm run cli && node dist-cli/hwdog.mjs test ../cases",
    "build:verify": "node scripts/verify-reproducible.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
