{
  "name": "hardware-dog-web",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware Dog local diagnostic interface",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "assets": "node scripts/build-brand-assets.mjs",
    "demo": "vite --open /diagnostic.html?demo",
    "cases": "UPDATE_CASES=1 vitest run test/cases.test.ts",
    "docs:sync": "node scripts/sync-raw-docs.mjs",
    "cli": "vite build --config vite.cli.config.ts",
    "test:cases": "npm run cli && node dist-cli/hwdog.mjs test ../cases"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "pdfjs-dist": "^6.2.108",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
